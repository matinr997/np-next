# NursePlus — environment template.
#
# Copy this file and fill in the values. NEVER commit the filled-in copy:
# .gitignore already excludes .env and api/config.php.
#
# Two environments exist:
#   local development   the AI endpoint may be on your own machine
#   production (Netafraz) everything is reachable from the host

# ---- the AI provider (OpenAI-compatible) ------------------------------
# The base URL of the provider, WITHOUT /chat/completions.
NP_AI_ENDPOINT=http://localhost:20128/v1
# The key. It is stored in api/config.php on the host, never in this file
# for production.
NP_AI_KEY=replace-me
# The model to use by default.
NP_AI_MODEL=oc/space-bunny-free

# ---- the site ----------------------------------------------------------
# The public root of the site, used by the worker to reach the API.
NP_SITE_URL=http://127.0.0.1:8125
# A random secret of at least 32 bytes. The worker sends it in the
# X-Worker-Token header. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
NP_WORKER_TOKEN=replace-me-with-32-random-bytes

# ---- the database ------------------------------------------------------
NP_DB_DRIVER=sqlite
NP_DB_NAME=nurseplus
NP_DB_HOST=localhost
NP_DB_USER=nurseplus
NP_DB_PASS=replace-me
NP_DB_CHARSET=utf8mb4

# ---- the first administrator -------------------------------------------
NP_ADMIN_EMAIL=admin@example.com
NP_ADMIN_PASSWORD=replace-me

# ---- deployment switches -----------------------------------------------
# Allow an AI endpoint on a private or loopback address. Keep this FALSE in
# production: it is the switch that would let a stored endpoint reach the
# host's own network.
NP_ALLOW_PRIVATE_ENDPOINT=false
# Comma-separated hosts that may be private even when the switch is false.
NP_ALLOW_PRIVATE_HOSTS=
